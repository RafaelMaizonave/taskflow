# Copy to .env when implementing the backend. Never commit the actual .env.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./data/taskflow.db
CORS_ORIGINS=["http://localhost:5173"]
