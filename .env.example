# Docker Compose: copie para .env ou deixe `make setup` / `make run` gerar automaticamente.
# Nunca versione o arquivo .env real. JWT_SECRET precisa de pelo menos 32 caracteres.
JWT_SECRET=
# Portas do ambiente local. O override publica o frontend só em 127.0.0.1.
# O docker-compose.yml não publica o frontend: a borda chega pelo alias
# taskflow-frontend na rede externa web-edge.
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# BACKEND_BIND=127.0.0.1
